# KGuard Backend Configuration

# Database
DATABASE_URL=sqlite:///./kguard.db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Security
# Required: the backend refuses to start without a key of 32+ characters.
# Generate one with: openssl rand -hex 32
SECRET_KEY=
# How long a login lasts
ACCESS_TOKEN_EXPIRE_MINUTES=480
# First admin, created only while there are no users
# (or later: python -m app.users create <name> --role admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Requests per minute per client to /api, and failed logins per minute
# per address and per username (0 = no limit)
RATE_LIMIT_PER_MINUTE=300
LOGIN_ATTEMPTS_PER_MINUTE=5
# Proxies whose X-Forwarded-For is believed
FORWARDED_ALLOW_IPS=127.0.0.1

# Browser origins that may call the API, and host names it answers to
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Kernel Module Interface
# Event source: auto (device if available), device or proc
KGUARD_SOURCE=auto
KGUARD_DEVICE_PATH=/dev/kguard
PROC_KGUARD_PATH=/proc/kguard
# Name the process behind each connection by scanning /proc
RESOLVE_PROCESSES=true
# auto: use the kernel module's own scan/SYN-flood alerts when it is loaded
# (the backend's copies of those rules switch off); off: always use backend rules
KERNEL_DETECTION=auto
DATA_COLLECTION_INTERVAL=1.0

# Anomaly Detection
PORT_SCAN_THRESHOLD=10
SUSPICIOUS_PORTS=[22,23,3389,5432,3306]
TRUSTED_SOURCES=[]
BRUTE_FORCE_THRESHOLD=10
SYN_FLOOD_THRESHOLD=200
SYN_FLOOD_WINDOW_SECONDS=10
BASELINE_INTERVAL_SECONDS=60
BASELINE_SIGMA=6.0
BASELINE_RATIO=5.0
BASELINE_MIN_COUNT=100
HIGH_FREQUENCY_THRESHOLD=100
DETECTION_WINDOW_SECONDS=60
ALERT_COOLDOWN_SECONDS=300
MAX_EVENTS_PER_MINUTE=1000

# WebSocket
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_EVENTS_PER_BATCH=20

# Remote agents (kguard-agent). Enrollment is off while the key is empty.
AGENT_ENROLLMENT_KEY=
MAX_INGEST_EVENTS=20000
