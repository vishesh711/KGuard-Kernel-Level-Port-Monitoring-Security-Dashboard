# Settings for docker compose (docker-compose.yml and docker-compose.prod.yml).
# Copy to .env (make setup does) and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# --- Required by both stacks -------------------------------------------------
# Signs login tokens; the backend refuses to start without 32+ characters
SECRET_KEY=
# The first admin, created on first start only (10+ characters)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Required by the production stack ----------------------------------------
POSTGRES_PASSWORD=
# Prometheus scrapes /metrics with this bearer token
METRICS_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# The host name users type in the browser (the API refuses other Host headers)
KGUARD_HOSTNAME=localhost

# --- Optional -------------------------------------------------------------------
# Group allowed to read /proc/kguard and /dev/kguard: load the module with the
# same number (sudo insmod kernel/kguard.ko reader_gid=1500)
KGUARD_READER_GID=1500
# Remote agents enroll with this key; empty = enrollment off
AGENT_ENROLLMENT_KEY=
# Notifications: set any channel to turn it on (backend/README.md, "Notifications")
NOTIFY_MIN_SEVERITY=HIGH
DASHBOARD_URL=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=[]
