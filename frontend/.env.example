# KGuard Frontend Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# App Configuration
VITE_APP_TITLE=KGuard Security Dashboard
VITE_APP_VERSION=2.0.0

# Update intervals (milliseconds)
VITE_REFRESH_INTERVAL=5000
VITE_WEBSOCKET_RECONNECT_INTERVAL=3000

# Chart configuration
VITE_CHART_ANIMATION_DURATION=300
VITE_MAX_CHART_POINTS=100

# Table configuration
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_PAGE_SIZE=100

# Development
VITE_DEBUG=false